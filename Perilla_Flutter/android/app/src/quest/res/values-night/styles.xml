<?xml version="1.0" encoding="utf-8"?>
<!-- Sustituye a los temas de src/main en el flavor quest: ventana translúcida
     y sin fondo, para que el panel no tenga relleno propio. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
